# The repo holds only what the live site uses. Everything below stays on
# disk locally (and in git history) but is never committed or deployed.

# ---- System and tooling
.DS_Store
.vscode/
.vercel/

# ---- Design working files, wherever they land (often hundreds of MB)
*.psd
*.psb
*.ai
*.indd
*.fig

# ---- Home page sources: original PNGs, mocks, retired artwork, and the
# texture-loop generator with its large loops (the site uses the WebPs in images/)
images/source/
images/laptop-screen-mockup-design/

# ---- Case-study sources: Figma exports, raw media, retired assets and the
# old image-slice pages (exports/<slug>/old-page/)
case-studies/exports/
# Loose PNGs (dot-grid.png is committed on purpose)
case-studies/*.png

# ---- Build tools, page template and working notes
case-studies/*.py
case-studies/*.swift
case-studies/template.html
docs/

# ---- Figma plugin for syncing the site's styles: a separate tool
portfolio-2026-figma-styles/
